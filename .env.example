# ==============================================================================
# WAS - Multi-Tenant WhatsApp CRM Platform Configuration
# Copy this file to .env and replace placeholders with secure credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME=WAS
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (WAS CRM)
# ------------------------------------------------------------------------------
POSTGRES_HOST=was-postgres
POSTGRES_PORT=5432
POSTGRES_USER=was_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=was_crm
DATABASE_URL=postgres://was_user:replace_with_strong_password@was-postgres:5432/was_crm?sslmode=disable

# ------------------------------------------------------------------------------
# Redis Cache & Real-Time Event Bus
# ------------------------------------------------------------------------------
REDIS_HOST=was-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://was-redis:6379

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_key
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# Evolution Go WhatsApp Engine
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://was-evolution:8080
EVOLUTION_GLOBAL_API_KEY=replace_with_evolution_global_api_key
EVOLUTION_CLIENT_NAME=WAS
EVOLUTION_OPERATOR_EMAIL=
EVOLUTION_WADEBUG=INFO

# PostgreSQL connection strings for Evolution Go internal session storage
EVOLUTION_POSTGRES_AUTH_DB=postgresql://was_user:replace_with_strong_password@was-postgres:5432/evogo_auth?sslmode=disable
EVOLUTION_POSTGRES_USERS_DB=postgresql://was_user:replace_with_strong_password@was-postgres:5432/evogo_users?sslmode=disable

# Webhook Callback Base URL (called by Evolution Go to push events to WAS Backend)
WEBHOOK_BASE_URL=http://was-backend:8080

# Mock Evolution Adapter (set to true for development without physical WhatsApp devices)
USE_MOCK_EVOLUTION_ADAPTER=false
